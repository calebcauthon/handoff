# agentfork keybindings for Ghostty (1.3 or newer, for chained actions).
#
# Included from your Ghostty config by install.sh with:
#   config-file = ?/path/to/agentfork/adapters/ghostty/agentfork.ghostty
#
# Ghostty can't tell agentfork which process the focused pane holds, so copy
# uses the only conversation active in the last 30 seconds, and shows a picker
# when that is ambiguous. Keybindings can't run programs, so copy opens a split
# and types the agentfork command into its shell.
#
# These use cmd+alt so they don't collide with herdr's ctrl+b prefix when
# herdr runs inside Ghostty.

# Copy a conversation. The split below closes once it is copied.
keybind = cmd+alt+c=new_split:down
keybind = chain=text:exec agentfork copy --notify\r

# Paste: start a fork of the copied conversation in this pane (at a shell prompt).
keybind = cmd+alt+v=text:agentfork paste\r

# Fork: copy the active conversation and paste it into a split on the right.
keybind = cmd+alt+right=new_split:right
keybind = chain=text:agentfork fork\r
